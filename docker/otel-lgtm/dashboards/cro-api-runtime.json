        }
      }
    },
    {
      "type": "timeseries",
      "id": 20,
      "title": "Response time",
      "description": "Server response time across all routes. When it rises together with event loop delay, the process itself is slow; alone, the database or Redis is.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
