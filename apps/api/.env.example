# Database
DATABASE_URL="postgresql://cro:cro_dev_password@localhost:5666/cro_grammar?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-to-a-random-string-min-16-chars"
JWT_REFRESH_SECRET="change-me-to-another-random-string-min-16-chars"
JWT_ACCESS_EXPIRY_SECONDS=900       # Access token lifetime in seconds (900 = 15min)
JWT_REFRESH_EXPIRY_SECONDS=2592000  # Session lifetime in seconds (2592000 = 30d, 604800 = 7d)

# better-auth session signing (required in production, min 32 chars)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-random-string-min-32-chars-long"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Apple OAuth (optional for local dev)
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# CORS
WEB_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"

# Stripe (optional for Phase 1)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# RevenueCat (optional for Phase 1)
REVENUECAT_WEBHOOK_SECRET=""

# App
PORT=3000
NODE_ENV="development"

# OpenTelemetry: traces and metrics go to the otel-lgtm container that
# `docker compose up -d` starts. See them in Grafana at GRAFANA_URL.
# Remove OTEL_EXPORTER_OTLP_ENDPOINT to turn telemetry off.
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_SERVICE_NAME="cro-api"
# Send metrics every 10 s instead of every 60 s, and spans every 1 s instead
# of every 5 s, to see changes sooner.
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_BSP_SCHEDULE_DELAY=1000
GRAFANA_URL="http://localhost:3001"
